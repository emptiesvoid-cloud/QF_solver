        {
          "path": "result.element_results.0.von_mises",
          "op": "relative_error",
          "reference_formula": "tet4_unit_uniaxial_von_mises",
          "tolerance": 1.0e-12,
          "reference_type": "analytic",
          "reference": "closed-form constrained unit TET4 compression stress state"
        },
        {"path": "result.audit.equilibrium.reaction_resultant.0", "op": "abs_error", "expected": 1000.0, "tolerance": 1.0e-10, "reference_type": "equilibrium_closed_form", "reference": "support reactions balance the applied compression force"},
        {"path": "result.audit.equilibrium.force_balance_relative_error", "op": "less_equal", "expected": 1.0e-12},
        {"path": "result.audit.equilibrium.linear_energy_identity_relative_error", "op": "less_equal", "expected": 1.0e-9}
      ]
    },
