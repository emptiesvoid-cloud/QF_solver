{
  "campaign": "qf_solver_engineering_v2",
  "description": "Campagne de preuves pour le perimetre mecanique souverain v1.",
  "default_profile": "engineering",
  "cases": [
    {
      "id": "SOV-TET4-STATIC-001",
      "requirement": "REQ-SOL-001",
      "description": "Statique lineaire TET4 avec audit d'equilibre.",
      "input": "../examples/tet4_static.json",
      "mode": "solve",
      "profile": "strict",
      "expected_status": "PASS",
      "replacement_candidate": true,
      "accepted_use": "Statique lineaire TET4 sur composants tetraedriques simples, avec equilibrium audit et evidence.",
      "checks": [
        {"path": "qualification.maturity.overall", "op": "equals", "expected": "stable"},
        {
          "path": "result.max_displacement",
          "op": "relative_error",
          "reference_formula": "tet4_unit_uniaxial_ux_displacement",
          "tolerance": 1.0e-12,
          "reference_type": "analytic",
          "reference": "closed-form constrained unit TET4 uniaxial solution"
        },
        {
          "path": "result.element_results.0.von_mises",
          "op": "relative_error",
          "reference_formula": "tet4_unit_uniaxial_von_mises",
          "tolerance": 1.0e-12,
          "reference_type": "analytic",
          "reference": "closed-form constrained unit TET4 uniaxial stress state"
        },
        {"path": "result.audit.equilibrium.free_relative_residual", "op": "less_equal", "expected": 1.0e-9},
        {"path": "result.audit.equilibrium.reaction_resultant.0", "op": "abs_error", "expected": -1000.0, "tolerance": 1.0e-10, "reference_type": "equilibrium_closed_form", "reference": "support reactions balance the applied UX force"},
        {"path": "result.audit.equilibrium.force_balance_relative_error", "op": "less_equal", "expected": 1.0e-12},
        {"path": "result.audit.equilibrium.linear_energy_identity_relative_error", "op": "less_equal", "expected": 1.0e-9}
      ]
    },
    {
      "id": "SOV-TET4-COMPRESSION-001",
      "requirement": "REQ-SOL-001",
      "description": "Compression lineaire TET4 avec signe du deplacement, contrainte et reactions analytiques.",
