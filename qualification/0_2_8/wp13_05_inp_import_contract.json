    "machine_readable": true
  },
  "api": {
    "proposed": "qf_solver.read_inp(path)",
    "status": "PROVISIONAL_UNTIL_OWNER_GATE"
  },
  "maturity": "EXPERIMENTAL_BOUNDED_CANDIDATE",
  "historical_integrity": {
    "element_analysis_registry_46_unchanged": true,
