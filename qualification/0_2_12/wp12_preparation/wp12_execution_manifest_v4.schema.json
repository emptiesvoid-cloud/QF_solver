{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qf-solver:wp12:execution-manifest:v4",
  "title": "WP12 single-node manifest with separate science/runner checkouts and protected Windows paths",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "unit_id",
    "status",
    "repository",
    "target",
    "scientific_identity",
    "runner_identity",
    "scope",
    "code_identity",
    "tests",
    "fixtures",
    "environment",
    "resource_limits",
    "attempt_policy",
    "destination",
    "oracle",
    "prepared_at",
    "authorization_reference",
    "isolation_assessment",
    "execution_context"
  ],
  "properties": {
    "schema": {
      "const": "qf-solver-wp12-execution-manifest-v4"
    },
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "status": {
      "const": "FROZEN_NOT_AUTHORIZED"
    },
    "repository": {
      "const": "emptiesvoid-cloud/QF_solver"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "commit",
        "git_tree",
        "require_clean_checkout",
        "allow_detached_at_exact_commit",
        "remote_name",
        "remote_url",
        "remote_ref"
      ],
      "properties": {
        "branch": {
          "const": "emptiesvoids-cloud/0.2.12"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "require_clean_checkout": {
          "const": true
        },
        "allow_detached_at_exact_commit": {
          "type": "boolean"
        },
        "remote_name": {
          "const": "origin"
        },
        "remote_url": {
          "const": "https://github.com/emptiesvoid-cloud/QF_solver.git"
        },
        "remote_ref": {
          "const": "refs/heads/emptiesvoids-cloud/0.2.12"
        }
      }
    },
    "scientific_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "git_tree"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "runner_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "git_tree"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_tree": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "capability_ids",
        "scientific_boundary"
      ],
      "properties": {
        "operation": {
          "const": "EXECUTE_ONE_TEST_NODE"
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "scientific_boundary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "code_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_files_sha256",
        "test_files_sha256",
        "fixture_files_sha256"
      ],
      "properties": {
        "source_files_sha256": {
          "$ref": "#/$defs/pathHashes"
        },
        "test_files_sha256": {
          "$ref": "#/$defs/pathHashes"
        },
        "fixture_files_sha256": {
          "$ref": "#/$defs/pathHashes"
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeid",
        "command_profile",
        "argv"
      ],
      "properties": {
        "nodeid": {
          "$ref": "#/$defs/nodeid"
        },
        "argv": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "const": "-m"
            },
            {
              "const": "pytest"
            },
            {
              "const": "-q"
            },
            {
              "const": "-p"
            },
            {
              "const": "no:cacheprovider"
            },
            {
              "const": "-p"
            },
            {
              "const": "scripts.wp12_runner.pytest_provenance_plugin"
            },
            {
              "const": "-o"
            },
            {
              "const": "addopts="
            },
            {
              "const": "--noconftest"
            },
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/nodeid"
            }
          ],
          "items": {
            "type": "string"
          }
        },
        "command_profile": {
          "const": "qf-wp12-single-node-pytest-v3"
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlays",
        "inline"
      ],
      "properties": {
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          }
        },
        "inline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inlineFixture"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "python_implementation",
        "architecture",
        "python_version",
        "venv_executable_sha256",
        "packages",
        "native_libraries",
        "thread_environment",
        "python_executable_path",
        "python_executable_sha256",
        "virtual_environment",
        "solver_import_origin",
        "temporary_directory",
        "junit_relative_path_from_science_checkout"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "python_implementation": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "venv_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "native_libraries": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "thread_environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "python_executable_path": {
          "type": "string",
          "minLength": 1
        },
        "python_executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "virtual_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "enum": [
                "venv",
                "system-python"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "solver_import_origin": {
          "type": "string",
          "minLength": 1
        },
        "temporary_directory": {
          "type": "string",
          "minLength": 1
        },
        "junit_relative_path_from_science_checkout": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "cpu_seconds",
        "memory_bytes",
        "process_count",
        "thread_count",
        "temporary_storage_bytes",
        "stdout_bytes",
        "stderr_bytes",
        "enforcement"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cpu_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "memory_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "process_count": {
          "type": "integer",
          "minimum": 1
        },
        "thread_count": {
          "type": "integer",
          "minimum": 1
        },
        "temporary_storage_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "stdout_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "stderr_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wall",
            "cpu",
            "memory",
            "process_tree",
            "storage",
            "logs",
            "threads"
          ],
          "properties": {
            "wall": {
              "enum": [
                "hard",
                "soft"
              ]
            },
            "cpu": {
              "enum": [
                "hard",
                "soft"
              ]
            },
            "memory": {
              "enum": [
                "hard",
                "soft"
              ]
            },
            "process_tree": {
              "enum": [
                "hard",
                "soft"
              ]
            },
            "storage": {
              "enum": [
                "hard",
                "soft"
              ]
            },
            "logs": {
              "enum": [
                "hard",
                "soft"
              ]
            },
            "threads": {
              "enum": [
                "hard",
                "soft"
              ]
            }
          }
        }
      }
    },
    "attempt_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_attempts",
        "automatic_retry"
      ],
      "properties": {
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "automatic_retry": {
          "const": false
        }
      }
    },
    "destination": {
      "type": "string",
      "pattern": "^qualification/0_2_12/wp12_evidence/[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "classification",
        "frozen_acceptance"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "frozen_acceptance": {
          "type": "object"
        }
      }
    },
    "prepared_at": {
      "type": "string",
      "format": "date"
    },
    "authorization_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "OWNER_DECISION_REQUIRED"
        }
      }
    },
    "isolation_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "runner_account",
        "runner_account_sid",
        "profile",
        "attestation_path",
        "sha256",
        "evidence_anchor_status",
        "review_status",
        "read_only_roots",
        "exclusive_write_root",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_VERIFIED",
            "VERIFIED"
          ]
        },
        "runner_account": {
          "type": "string",
          "minLength": 1
        },
        "runner_account_sid": {
          "type": "string",
          "pattern": "^S-1-[0-9-]+$"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "attestation_path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evidence_anchor_status": {
          "enum": [
            "NOT_CONFIGURED",
            "VERIFIED"
          ]
        },
        "review_status": {
          "enum": [
            "NOT_REVIEWED",
            "INDEPENDENTLY_REVIEWED"
          ]
        },
        "read_only_roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "exclusive_write_root": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "execution_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "science_checkout",
        "runner_checkout",
        "python_executable",
        "venv_root",
        "python_base_root",
        "working_directory",
        "plugin_path",
        "solver_import_root",
        "pythonpath",
        "requirements_lock_sha256",
        "inline_fixture",
        "expected_packages",
        "expected_native_libraries_sha256",
        "thread_environment",
        "evidence_root",
        "destination_path",
        "temporary_root",
        "archive",
        "isolation_attestation",
        "security_review",
        "attempt_id",
        "runner_files_sha256"
      ],
      "properties": {
        "science_checkout": {
          "$ref": "#/$defs/checkoutIdentity"
        },
        "runner_checkout": {
          "$ref": "#/$defs/checkoutIdentity"
        },
        "python_executable": {
          "type": "string",
          "minLength": 1
        },
        "venv_root": {
          "type": "string",
          "minLength": 1
        },
        "python_base_root": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "minLength": 1
        },
        "plugin_path": {
          "type": "string",
          "minLength": 1
        },
        "solver_import_root": {
          "type": "string",
          "minLength": 1
        },
        "pythonpath": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requirements_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "inline_fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema",
            "fixture_id",
            "canonicalization",
            "sha256"
          ],
          "properties": {
            "schema": {
              "const": "qf-wp12-inline-fixture-v1"
            },
            "fixture_id": {
              "type": "string",
              "minLength": 1
            },
            "canonicalization": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "expected_packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_native_libraries_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        },
        "thread_environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "OMP_NUM_THREADS",
            "OPENBLAS_NUM_THREADS",
            "MKL_NUM_THREADS",
            "BLIS_NUM_THREADS",
            "VECLIB_MAXIMUM_THREADS",
            "NUMEXPR_NUM_THREADS"
          ],
          "properties": {
            "OMP_NUM_THREADS": {
              "const": "1"
            },
            "OPENBLAS_NUM_THREADS": {
              "const": "1"
            },
            "MKL_NUM_THREADS": {
              "const": "1"
            },
            "BLIS_NUM_THREADS": {
              "const": "1"
            },
            "VECLIB_MAXIMUM_THREADS": {
              "const": "1"
            },
            "NUMEXPR_NUM_THREADS": {
              "const": "1"
            }
          }
        },
        "evidence_root": {
          "type": "string",
          "minLength": 1
        },
        "destination_path": {
          "type": "string",
          "minLength": 1
        },
        "temporary_root": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "method",
            "destination",
            "request_root",
            "owner_decision_root",
            "manifest_path",
            "python_executable",
            "python_executable_sha256",
            "decision_verifier_script_path",
            "decision_verifier_script_sha256",
            "contracts_script_sha256",
            "owner_trust_script_sha256",
            "canonicalization_script_sha256",
            "execution_attestation",
            "worker_task_name",
            "worker_script_path",
            "worker_script_sha256",
            "ack_timeout_seconds"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_CONFIGURED",
                "CONFIGURED"
              ]
            },
            "method": {
              "const": "ADMINISTRATOR_SEALED_COPY_V1"
            },
            "destination": {
              "type": "string",
              "minLength": 1
            },
            "request_root": {
              "type": "string",
              "minLength": 1
            },
            "owner_decision_root": {
              "type": "string",
              "minLength": 1
            },
            "manifest_path": {
              "type": "string",
              "minLength": 1
            },
            "python_executable": {
              "type": "string",
              "minLength": 1
            },
            "python_executable_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "decision_verifier_script_path": {
              "type": "string",
              "minLength": 1
            },
            "decision_verifier_script_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "contracts_script_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "owner_trust_script_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "canonicalization_script_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "execution_attestation": {
              "const": "NONE"
            },
            "worker_task_name": {
              "const": "\\QFSolverWP12\\ArchiveWorker"
            },
            "worker_script_path": {
              "type": "string",
              "minLength": 1
            },
            "worker_script_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "ack_timeout_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "isolation_attestation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "status"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "enum": [
                "NOT_VERIFIED",
                "VERIFIED"
              ]
            }
          }
        },
        "security_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "review_record_path",
            "sha256"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_REVIEWED",
                "INDEPENDENTLY_REVIEWED"
              ]
            },
            "review_record_path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "runner_files_sha256": {
          "$ref": "#/$defs/pathHashes"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pathHashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "nodeid": {
      "type": "string",
      "pattern": "^tests/(unit|integration|verification)/[A-Za-z0-9_./-]+\\.py::[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)?(\\[[^\\]\\r\\n]+\\])?$"
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "source_commit",
        "git_blob_oid",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "git_blob_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "inlineFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeid",
        "source_file",
        "source_file_sha256",
        "canonicalization",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "nodeid": {
          "$ref": "#/$defs/nodeid"
        },
        "source_file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
        },
        "source_file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalization": {
          "const": "qf-wp12-inline-fixture-v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "checkoutIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "commit",
        "git_tree"
      ],
      "properties": {
        "path": {
          "type": "string",
