{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qf-solver:wp12:execution-manifest:v2",
  "title": "Owner-frozen WP12 single-unit execution manifest with separate science and runner identities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "campaign_id", "unit_id", "status", "repository", "target", "scientific_identity", "runner_identity", "scope",
    "code_identity", "tests", "fixtures", "environment", "resource_limits", "attempt_policy",
    "destination", "oracle", "prepared_at", "authorization_reference"
  ],
  "properties": {
    "schema": {"const": "qf-solver-wp12-execution-manifest-v2"},
    "campaign_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "unit_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "status": {"const": "FROZEN_NOT_AUTHORIZED"},
    "repository": {"const": "emptiesvoid-cloud/QF_solver"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["branch", "commit", "git_tree", "require_clean_checkout", "allow_detached_at_exact_commit"],
      "properties": {
        "branch": {"const": "emptiesvoids-cloud/0.2.12"},
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "git_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "require_clean_checkout": {"const": true},
        "allow_detached_at_exact_commit": {"type": "boolean"}
      }
    },
    "scientific_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "git_tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "git_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "runner_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "git_tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "git_tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "capability_ids", "scientific_boundary"],
      "properties": {
        "operation": {"const": "EXECUTE_ONE_TEST_NODE"},
        "capability_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "scientific_boundary": {"type": "string", "minLength": 1}
      }
    },
    "code_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["source_files_sha256", "test_files_sha256", "fixture_files_sha256"],
      "properties": {
        "source_files_sha256": {"$ref": "#/$defs/pathHashes"},
        "test_files_sha256": {"$ref": "#/$defs/pathHashes"},
        "fixture_files_sha256": {"$ref": "#/$defs/pathHashes"}
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeid", "argv"],
      "properties": {
        "nodeid": {"$ref": "#/$defs/nodeid"},
        "argv": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "prefixItems": [
            {"type": "string", "minLength": 1},
            {"const": "-m"},
            {"const": "pytest"},
            {"const": "-q"},
            {"$ref": "#/$defs/nodeid"}
          ],
          "items": {"type": "string"}
        }
      }
    },
    "fixtures": {
      "type": "object", "additionalProperties": false,
      "required": ["overlays"],
      "properties": {
        "overlays": {
          "type": "array", "items": {"$ref": "#/$defs/overlay"}
        }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["platform", "python_version", "venv_executable_sha256", "packages", "native_libraries", "thread_environment"],
      "properties": {
        "platform": {"type": "string", "minLength": 1},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "venv_executable_sha256": {"$ref": "#/$defs/sha256"},
        "packages": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "native_libraries": {"type": "object", "additionalProperties": {"type": "string"}},
        "thread_environment": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "resource_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["wall_seconds", "cpu_seconds", "memory_bytes", "process_count", "thread_count", "temporary_storage_bytes", "stdout_bytes", "stderr_bytes", "enforcement"],
      "properties": {
        "wall_seconds": {"type": "integer", "minimum": 1},
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "process_count": {"type": "integer", "minimum": 1},
        "thread_count": {"type": "integer", "minimum": 1},
        "temporary_storage_bytes": {"type": "integer", "minimum": 1},
        "stdout_bytes": {"type": "integer", "minimum": 1},
        "stderr_bytes": {"type": "integer", "minimum": 1},
        "enforcement": {
          "type": "object", "additionalProperties": false,
          "required": ["wall", "cpu", "memory", "process_tree", "storage", "logs"],
          "properties": {
            "wall": {"enum": ["hard", "soft"]}, "cpu": {"enum": ["hard", "soft"]},
            "memory": {"enum": ["hard", "soft"]}, "process_tree": {"enum": ["hard", "soft"]},
            "storage": {"enum": ["hard", "soft"]}, "logs": {"enum": ["hard", "soft"]}
          }
        }
      }
    },
    "attempt_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_attempts", "automatic_retry"],
      "properties": {"maximum_attempts": {"type": "integer", "minimum": 1}, "automatic_retry": {"const": false}}
    },
    "destination": {"type": "string", "pattern": "^qualification/0_2_12/wp12_evidence/[A-Za-z0-9][A-Za-z0-9._-]{0,63}/[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "oracle": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "classification", "frozen_acceptance"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "classification": {"type": "string", "minLength": 1},
        "frozen_acceptance": {"type": "object"}
      }
    },
    "prepared_at": {"type": "string", "format": "date"},
    "authorization_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_id", "decision_sha256"],
      "properties": {"decision_id": {"type": "string", "minLength": 1}, "decision_sha256": {"$ref": "#/$defs/sha256"}}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pathHashes": {"type": "object", "minProperties": 1, "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"}, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "nodeid": {"type": "string", "pattern": "^tests/(unit|integration|verification)/[A-Za-z0-9_./-]+\\.py::[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)?(\\[[^\\]\\r\\n]+\\])?$"},
    "overlay": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "source_commit", "git_blob_oid", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"},
        "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "git_blob_oid": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
