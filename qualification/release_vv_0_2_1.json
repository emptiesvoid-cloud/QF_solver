  "policy": {
    "required_scope_failure": "FAIL",
    "candidate_scope_missing_evidence": "FAIL",
    "campaign_not_executed": "FAIL",
    "owner_review_pending": "FAIL",
    "certification_claim": "none",
    "qualification_requires_owner_review": true,
    "matrix_scope_policy": {
      "include_all": true,
      "exclude_statuses": [
        "unsupported",
        "owner_accepted",
        "owner_accepted_experimental_bounded_use",
        "experimental",
        "research",
        "out_of_acceptance"
      ],
      "target_status": "stable",
      "proof_requirements": {
        "analytical_or_invariant": true,
        "convergence": true,
        "external_correlation": true,
        "owner_review": true
      },
      "description": "Only stable matrix scopes are release blockers. Bounded, experimental, research and out-of-acceptance capabilities remain distributed with their explicit maturity and exclusions, but cannot be presented as stable release claims."
    }
  },
  "campaign": {
    "manifest": "qualification/campaign.json",
    "required": true
  },
