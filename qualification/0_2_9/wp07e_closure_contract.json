    "denominators": {
      "selected_displacement": "max(abs(M2), abs(M3), U_char, absolute_floor)",
      "reaction_resultant": "max(norm(M2), norm(M3), F_char, absolute_floor)",
      "reaction_moment": "max(norm(M2), norm(M3), M_char, absolute_floor)",
      "contact_resultant": "max(norm(M2), norm(M3), F_char, absolute_floor)",
      "contact_region_measure": "max(abs(M2), abs(M3), 1)",
      "normalized_penetration": "max(abs(M2), abs(M3), penetration_scale, absolute_floor)",
      "contact_energy": "max(abs(M2), abs(M3), E_char, absolute_floor)",
      "optional_averaged_stress": "max(abs(M2), abs(M3), stress_scale, absolute_floor)"
    },
    "missing_observable": "FAIL_CLOSED"
  },
  "equilibrium_policy": {
    "force": {
      "expression": "norm(R_support + F_external) / max(norm(R_support), norm(F_external), F_char, absolute_floor)",
