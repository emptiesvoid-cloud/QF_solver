    "tests/unit/test_j17_exact_residual.py": "369819d07e7eb2658e1cdc5c8aa494a8269204017267bfe58d9fb6c8e357dd46"
  },
  "status_policy": "PASS/FAIL describe only exact residuals of supplied represented values. They do not alter historical QF_GUARD_REJECTED statuses."
}
