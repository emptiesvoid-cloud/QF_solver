    "source_commit_before_tests": "be455745f4a1c2cf81cb9448830223107dc39b66"
  },
  "purpose": "Exercise exact residual comparison for controlled represented systems; no solver call, model assembly, or FEM.",
  "criteria": {
    "tolerance_binary64": "1e-7",
    "pass": "Exact rational squared residual ratio <= exact square of float64 tolerance",
    "fail": "Exact rational squared residual ratio > exact square of float64 tolerance",
    "inconclusive": "Non-finite, malformed, unsupported, or over-budget inputs",
    "controls": [
      "comfortably below and above threshold",
      "0.99x and 1.01x threshold neighborhood",
      "complex-valued system",
      "ill-conditioned system with 1e-300 residual scale",
      "zero reference and nonzero tiny reference",
      "non-finite, wrong-shape, unsupported dtype, and budget cap"
    ]
  },
  "tests": [
    "tests/unit/test_j17_exact_residual.py::test_exact_residual_pass_fail_and_threshold_neighborhood",
    "tests/unit/test_j17_exact_residual.py::test_exact_residual_uses_complex_binary_values_without_float_norms",
    "tests/unit/test_j17_exact_residual.py::test_exact_residual_handles_ill_conditioning_and_tiny_norms",
    "tests/unit/test_j17_exact_residual.py::test_exact_residual_defines_zero_reference_and_small_scale_cases",
    "tests/unit/test_j17_exact_residual.py::test_invalid_nonfinite_and_over_budget_inputs_are_inconclusive"
  ],
  "execution": {
    "command": "python -m pytest <one exact nodeid> -q",
    "attempts_per_nodeid": 1,
    "timeout_seconds": 60,
    "rss_soft_limit_mib": 512,
    "output_limit_mib": 2,
    "storage_limit_mib": 8,
    "fem_or_solver_calls": false,
    "run_one_nodeid_per_command": true
  },
  "artifacts": [
    "One pytest log per exact nodeid under research/j17/results/unit_tests_001/",
    "No QF route status or historic artifact is written."
  ],
  "source_sha256": {
