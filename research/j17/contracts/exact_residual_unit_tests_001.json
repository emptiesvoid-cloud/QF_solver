{
  "schema": "qfsolver-j17-nonfem-test-contract-v1",
  "contract_id": "J17-EXACT-RESIDUAL-UNIT-TESTS-001",
  "state": "FROZEN_BEFORE_EXECUTION",
  "classification": "BOUNDED_NON_FEM_UNIT_TESTS",
  "owner_authorization": "QF Solver 0.3.0 J17 Owner instruction",
  "baseline": {
    "main_commit": "be455745f4a1c2cf81cb9448830223107dc39b66",
